# Forge itself is downloaded, never committed. 300 MB of someone else's GPL
# code plus card data, pinned by scripts/fetch-forge.sh.
vendor/

# Build output
java/build/
dist/
*.egg-info/
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/

# Transcripts and live match state live under XDG paths, but a stray run with
# an overridden home would land them here.
*.db
# The committed collection fixture is the exception. Without it the suite
# reads whatever collection the developer happens to have, and the paths CI
# cannot reach go untested.
!tests/fixtures/*.db
*.sock
reports/*/data/sweep-progress.log
